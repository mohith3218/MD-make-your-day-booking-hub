# Development example only. Production must use PostgreSQL, a stable secret,
# Razorpay credentials and a webhook secret. Mock payments are dev/test only.
APP_ENV=development
DATABASE_URL=sqlite:///vizag_movies.db
TMDB_API_KEY=

# Copy this file to .env, then fill in the values from your email provider.
# For Gmail, use an App Password (not your normal Google account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_SSL=0

# Generate a private random value for your local app session signing key.
SECRET_KEY=replace-with-a-long-random-secret

# Payment gateway settings (leave empty for local development mock checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production example: APP_ENV=production and DATABASE_URL=postgresql+psycopg://...
# Never commit real credentials or use the development mock gateway in production.

# Supabase: copy the Session pooler URI (port 5432) from the Connect panel.
# Percent-encode the actual password; keep it ONLY in your ignored .env.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# For certificate verification, use sslmode=verify-full&sslrootcert=/absolute/path/to/ca.crt
DATABASE_SSLMODE=require
# Needed only when creating a brand-new local admin; never changes existing users.
ADMIN_PASSWORD=
# TEST_DATABASE_URL is assigned to a temporary absolute SQLite file by tests.
# Never point automated tests at Supabase or the local development database.
