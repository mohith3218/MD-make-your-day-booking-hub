# Local development uses SQLite. All payments and wallet credits are DEMO only.
APP_ENV=development
DATABASE_URL=sqlite:///vizag_movies.db
DATABASE_SSLMODE=require
# Production defaults to disabled; explicitly set true on Render for demo checkout.
DEMO_PAYMENTS_ENABLED=true
SECRET_KEY=replace-with-a-private-random-secret-at-least-32-characters
TMDB_API_KEY=

# Optional ticket email. Render Free blocks standard SMTP ports; web tickets still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=0

# Only for explicitly creating a brand-new development admin. Existing users are preserved.
ADMIN_PASSWORD=
# Render production: APP_ENV=production, plus your existing Supabase Session pooler URI.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Never commit real credentials. Tests assign their own isolated TEST_DATABASE_URL.
